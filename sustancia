<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Victoria 2 Mod Creator</title>
    <style>
        :root {
            --bg-color: #1e1e24;
            --panel-bg: #2b2b36;
            --text-main: #e0e0e0;
            --text-muted: #8e8e9f;
            --accent: #b33939;
            --accent-hover: #d24b4b;
            --border: #3f3f4e;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            display: flex;
            flex-direction: column;
            height: 100vh;
        }

        header {
            background-color: #15151a;
            padding: 1rem 2rem;
            border-bottom: 2px solid var(--accent);
            text-align: center;
        }

        header h1 {
            font-family: 'Georgia', serif;
            letter-spacing: 1px;
            color: #fff;
        }

        .container {
            display: flex;
            flex: 1;
            overflow: hidden;
        }

        /* Panel de Configuración */
        .config-panel {
            width: 350px;
            background-color: var(--panel-bg);
            padding: 1.5rem;
            border-right: 1px solid var(--border);
            overflow-y: auto;
        }

        .input-group {
            margin-bottom: 1.2rem;
        }

        .input-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: bold;
            font-size: 0.9rem;
        }

        .input-group p {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-bottom: 0.5rem;
        }

        input[type="file"] {
            width: 100%;
            padding: 0.5rem;
            background-color: var(--bg-color);
            border: 1px solid var(--border);
            color: var(--text-main);
            border-radius: 4px;
        }

        button {
            width: 100%;
            padding: 0.8rem;
            background-color: var(--accent);
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.3s;
        }

        button:hover {
            background-color: var(--accent-hover);
        }

        /* Panel Interactivo (Workspace) */
        .workspace {
            flex: 1;
            display: flex;
            flex-direction: column;
            background-color: var(--bg-color);
        }

        .dashboard {
            display: none; /* Oculto hasta que se carguen datos */
            flex: 1;
            flex-direction: row;
            height: 100%;
        }

        .country-list {
            width: 250px;
            background-color: #22222a;
            border-right: 1px solid var(--border);
            overflow-y: auto;
        }

        .country-item {
            padding: 1rem;
            border-bottom: 1px solid var(--border);
            cursor: pointer;
            transition: background 0.2s;
        }

        .country-item:hover {
            background-color: var(--panel-bg);
        }

        .country-item.active {
            background-color: var(--accent);
            border-left: 4px solid white;
        }

        .details-panel {
            flex: 1;
            padding: 2rem;
            overflow-y: auto;
        }

        .details-panel h2 {
            font-size: 2rem;
            margin-bottom: 1rem;
            border-bottom: 1px solid var(--border);
            padding-bottom: 0.5rem;
        }

        .data-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
            margin-top: 1.5rem;
        }

        .card {
            background-color: var(--panel-bg);
            padding: 1.5rem;
            border-radius: 6px;
            border: 1px solid var(--border);
        }

        .card h3 {
            color: var(--accent);
            margin-bottom: 1rem;
        }

        .empty-state {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100%;
            color: var(--text-muted);
            text-align: center;
            padding: 2rem;
            flex-direction: column;
        }

    </style>
</head>
<body>

    <header>
        <h1>Victoria 2 Mod Creator</h1>
    </header>

    <div class="container">
        <!-- Panel de Configuración -->
        <div class="config-panel">
            <h2>Directorios del Juego</h2>
            <br>
            
            <div class="input-group">
                <label>Archivo countries.txt</label>
                <p>El archivo base que define los tags.</p>
                <input type="file" id="fileCountriesTxt" accept=".txt">
            </div>

            <div class="input-group">
                <label>Carpeta /countries</label>
                <p>Archivos de color, partidos y culturas.</p>
                <input type="file" id="dirCountries" webkitdirectory directory multiple>
            </div>

            <div class="input-group">
                <label>Carpeta history/countries</label>
                <p>Archivos de historia de cada nación.</p>
                <input type="file" id="dirHistory" webkitdirectory directory multiple>
            </div>

            <div class="input-group">
                <label>Carpeta history/provinces</label>
                <p>Propietarios e infraestructura.</p>
                <input type="file" id="dirProvinces" webkitdirectory directory multiple>
            </div>

            <div class="input-group">
                <label>Carpeta history/pops</label>
                <p>Población en 1836 y 1861.</p>
                <input type="file" id="dirPops" webkitdirectory directory multiple>
            </div>

            <button id="btnCrear">Cargar Datos y Crear Entorno</button>
        </div>

        <!-- Área de Trabajo -->
        <div class="workspace">
            <div class="empty-state" id="emptyState">
                <h2>Esperando datos...</h2>
                <p>Selecciona las carpetas en el panel izquierdo y haz clic en "Cargar Datos".</p>
            </div>

            <div class="dashboard" id="dashboard">
                <div class="country-list" id="countryList">
                    <!-- Los países se cargarán aquí -->
                </div>
                
                <div class="details-panel" id="detailsPanel">
                    <h2 id="selectedCountryName">Selecciona un país</h2>
                    
                    <div class="data-grid">
                        <div class="card">
                            <h3>Provincias Controladas</h3>
                            <p id="provCount">Esperando selección...</p>
                            <ul id="provList" style="margin-top: 10px; padding-left: 20px; color: var(--text-muted); font-size: 0.9rem;"></ul>
                        </div>
                        <div class="card">
                            <h3>Población (Pops)</h3>
                            <p id="popData">Esperando selección...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('btnCrear').addEventListener('click', function() {
            // Obtenemos los archivos seleccionados en los inputs
            const historyFiles = document.getElementById('dirHistory').files;
            const popFiles = document.getElementById('dirPops').files;
            
            if (historyFiles.length === 0) {
                alert("Por favor, selecciona al menos la carpeta 'history/countries' para generar la lista de países.");
                return;
            }

            // Ocultar estado vacío, mostrar dashboard
            document.getElementById('emptyState').style.display = 'none';
            const dashboard = document.getElementById('dashboard');
            dashboard.style.display = 'flex';

            const countryList = document.getElementById('countryList');
            countryList.innerHTML = ''; // Limpiar lista

            // Usamos la carpeta history/countries para extraer los nombres de los países
            // Los archivos suelen llamarse "ENG - England.txt"
            
            // Convertimos FileList a Array y lo ordenamos alfabéticamente
            let filesArray = Array.from(historyFiles);
            filesArray.sort((a, b) => a.name.localeCompare(b.name));

            filesArray.forEach(file => {
                if (file.name.endsWith('.txt')) {
                    // Extraer TAG y Nombre del archivo (ej. "ENG - England")
                    let countryName = file.name.replace('.txt', '');
                    
                    let div = document.createElement('div');
                    div.className = 'country-item';
                    div.innerText = countryName;
                    
                    div.onclick = function() {
                        // Quitar clase active a los demás
                        document.querySelectorAll('.country-item').forEach(el => el.classList.remove('active'));
                        div.classList.add('active');
                        
                        // Actualizar panel derecho
                        mostrarDetallesPais(countryName, file);
                    };
                    
                    countryList.appendChild(div);
                }
            });
        });

        function mostrarDetallesPais(countryName, fileObject) {
            document.getElementById('selectedCountryName').innerText = countryName;
            
            // Aquí en el futuro usaremos FileReader para leer los contenidos reales de los .txt
            // Por ahora mostramos información simulada del entorno
            document.getElementById('provCount').innerText = "Cargando análisis de archivos...";
            document.getElementById('provList').innerHTML = "<li>Lectura de /provinces pendiente...</li>";
            document.getElementById('popData').innerText = "Análisis del motor Clausewitz requerido para leer los bloques de población.";
            
            // Ejemplo de cómo se leería un archivo real en JS:
            const reader = new FileReader();
            reader.onload = function(e) {
                const contenido = e.target.result;
                // Esto imprimiría el texto del archivo de historial en la consola
                console.log(`Contenido de ${countryName}:`, contenido.substring(0, 100) + "...");
            };
            reader.readAsText(fileObject);
        }
    </script>
</body>
</html>
